# Auto-generated by scripts/xcframework.swift
Pod::Spec.new do |spec|
  spec.name = "LiveKitClient-XCFramework"
  spec.version = "{{ version }}"
  spec.summary = "Pre-built LiveKit Swift Client SDK. Easily build live audio or video experiences into your mobile app, game or website."
  spec.homepage = "https://github.com/livekit/client-sdk-swift-xcframework"
  spec.license = {:type => "Apache 2.0", :file => "LICENSE"}
  spec.author = "LiveKit"

  # Platform support mirrors LiveKitClient.podspec; the binary also carries
  # tvOS/visionOS slices, but those platforms stay SPM-only as with the source pod.
  {{ platforms }}

  spec.swift_versions = ["5.9"]
  spec.source = {:git => "https://github.com/livekit/client-sdk-swift-xcframework.git", :tag => spec.version.to_s}

  # The framework is a release asset, not repo content.
  spec.prepare_command = <<-CMD
    set -e
    curl -fsSL -O "https://github.com/livekit/client-sdk-swift-xcframework/releases/download/#{spec.version}/LiveKit.xcframework.zip"
    unzip -q LiveKit.xcframework.zip
    rm LiveKit.xcframework.zip
  CMD

  spec.module_name = "LiveKit"
  spec.vendored_frameworks = "LiveKit.xcframework"

  spec.dependency("LiveKitWebRTC", "= {{ webrtcVersion }}")
  spec.dependency("LiveKitUniFFI", "= {{ uniffiVersion }}")
end
